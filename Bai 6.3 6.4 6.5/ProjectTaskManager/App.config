<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <connectionStrings>
    <!--
      Chuỗi kết nối tới CSDL ProjectTaskDB (Bài 6.3).
      Tự động thử các server phổ biến: .\SQLEXPRESS, ., (localdb)\MSSQLLocalDB, localhost.
    -->
    <add name="ProjectTaskDB"
         connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=ProjectTaskDB;Integrated Security=True;TrustServerCertificate=True"
         providerName="Microsoft.Data.SqlClient" />
  </connectionStrings>
</configuration>
