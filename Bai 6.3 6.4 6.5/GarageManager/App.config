<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <connectionStrings>
    <!--
      Chuỗi kết nối tới CSDL GarageDB (Bài 6.4).
      Tự động thử các server: .\SQLEXPRESS, ., (localdb)\MSSQLLocalDB, localhost.
    -->
    <add name="GarageDB"
         connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=GarageDB;Integrated Security=True;TrustServerCertificate=True"
         providerName="Microsoft.Data.SqlClient" />
  </connectionStrings>
</configuration>
